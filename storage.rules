rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images are served from the VPS engine (/uploads), not
    // from this bucket. Keep Storage locked: no client writes at all —
    // otherwise any authenticated user could overwrite another bot's
    // files (cross-tenant). Revisit with owner-scoped cross-service
    // rules only if Storage actually gets used.
    match /bots/{botId}/products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
