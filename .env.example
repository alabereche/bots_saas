# ═══════════════════════════════════════════════════════════════
# BotForge Production Environment Configuration — TEMPLATE ONLY.
# Copy to .env and fill with REAL values. Never commit real secrets.
# ═══════════════════════════════════════════════════════════════

# Engine ports
PORT=3002

# Google Gemini AI (Default: Gemini 3.5 Flash-Lite)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
DEFAULT_AI_MODEL=gemini-3.5-flash-lite

# ─── VPS engines only (bot-engine + whatsapp-engine) ──────────────
# Service account for the Firebase Admin SDK. In the Firebase
# console: Project settings → Service accounts → Generate new
# private key, then: base64 -w0 key.json  → paste below.
# (Alternatively set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json)
FIREBASE_SERVICE_ACCOUNT_B64=YOUR_BASE64_SERVICE_ACCOUNT_JSON_HERE

# Optional engine tuning
MAX_CONCURRENT_BOTS=10

# ─── Frontend (Vercel) engine endpoints ──────────────────────────
# Serve over HTTPS in production (Caddy/nginx in front of the engines)
VITE_ENGINE_URL=https://your-domain.com/telegram-engine
VITE_WHATSAPP_ENGINE_URL=https://your-domain.com/whatsapp-engine

# ─── Frontend Firebase (web config — public by design) ────────────
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
