rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnDoc() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Owner of the document's data, enforced on the document itself
    // (every conversation/order carries a denormalized userId)
    function isDataOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnData() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Updates may not re-assign a document to another owner or bot
    function keepsIdentityData() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.botId == resource.data.botId;
    }

    // ─── Super Admin (custom claim set server-side only) ──────────
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── User Profiles (users collection) ─────────────────────────
    // Protects against Privilege Escalation (preventing users from injecting admin roles or upgrading plans directly)
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create: if isOwner(userId)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'superAdmin', 'permissions']);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'role', 'isAdmin', 'superAdmin', 'permissions']);
      allow delete: if false;
    }

    // ─── Bots (bots collection) ───────────────────────────────────
    // Owner-only access. The VPS engines read/write through the
    // Firebase Admin SDK, which bypasses these rules entirely.
    match /bots/{botId} {
      allow read: if isDocOwner() || isSuperAdmin();
      allow create: if isCreatingOwnDoc();
      allow update: if isDocOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner();
    }

    // ─── Conversations (conversations collection) ─────────────────
    // Each document carries the owner's userId; clients must query
    // with where('userId', '==', <their uid>) for the rule to authorize.
    // Bot engines write via the Admin SDK (rules do not apply).
    match /conversations/{msgId} {
      allow read: if isDataOwner();
      allow create: if isCreatingOwnData();
      allow update: if isDataOwner() && keepsIdentityData();
      allow delete: if isDataOwner();
    }

    // ─── Orders & Bookings (orders collection) ─────────────────────
    match /orders/{orderId} {
      allow read: if isDataOwner() || isSuperAdmin();
      allow create: if isCreatingOwnData();
      allow update: if isDataOwner() && keepsIdentityData();
      allow delete: if isDataOwner();
    }

    // ─── Qualified Leads & CRM (leads collection) ─────────────────
    match /leads/{leadId} {
      allow read: if isDataOwner() || isSuperAdmin();
      allow create: if isCreatingOwnData();
      allow update: if isDataOwner() && keepsIdentityData();
      allow delete: if isDataOwner();
    }

    // ─── Notifications (in-app bell) ──────────────────────────────
    // Written ONLY by the engines via the Admin SDK (client create is
    // denied); the owner reads and marks his own as read.
    match /notifications/{notifId} {
      allow read: if isDataOwner();
      allow create: if false;
      allow update: if isDataOwner() && keepsIdentityData();
      allow delete: if isDataOwner();
    }

    // ─── Daily plan usage (billing/usage counter) ─────────────────
    // Written ONLY by the engines via the Admin SDK — a client can never
    // reset or inflate its own daily message quota. Docs carry the
    // owner's userId so he can read his own usage.
    match /usage/{docId} {
      allow read: if isDataOwner();
      allow write: if false;
    }
  }
}
